{% comment %}
  Star Moda — Homepage editorial
  ======================================================================
  Rediseño sobre la base original. Se conserva la paleta oficial completa
  (espresso / crema / beige / rosa / mocha / dorado) y se reconstruye todo
  lo demás sobre un sistema:

  · RITMO      un único token de banda vertical y de canal lateral, en vez
               de paddings sueltos de 60/64/80px.
  · JERARQUÍA  escala tipográfica fluida con tracking negativo en display
               (Cormorant abre demasiado a 60px+).
  · CADENCIA   las bandas alternan valor — crema, beige, espresso, blanco,
               rosa — para que el scroll tenga respiración y no sea un
               bloque plano de crema.
  · CONTRASTE  mocha y dorado quedan para trazos y rellenos; el texto chico
               usa --star-mocha-ink / --star-muted, que sí pasan AA.

  Tokens globales en assets/star-moda.css. Aquí se redeclaran para que la
  sección siga siendo correcta aunque se renderice aislada.
{% endcomment %}

{% liquid
  assign new_arrivals = section.settings.new_arrivals_collection
  assign bestsellers = section.settings.bestsellers_collection
  assign marquee_words = section.settings.marquee_words | split: ','
%}

<style>
  /* ==================================================================
   * 0. TOKENS DE SECCIÓN
   * ================================================================== */
  #shopify-section-{{ section.id }} {
    --star-black: #1c1b1a;
    --star-cream: #f7f3ee;
    --star-white: #fffdfa;
    --star-beige: #dccdb8;
    --star-rose: #d8b6b6;
    --star-mocha: #9b7b6c;
    --star-mocha-ink: #7d6055;
    --star-gold: #d8b16a;
    --star-muted: #756a62;

    --star-hair: rgba(28, 27, 26, 0.12);
    --star-hair-strong: rgba(28, 27, 26, 0.26);

    --star-display: var(--font-heading-family);
    --star-body: var(--font-body-family);

    --star-fs-display-xl: clamp(4.4rem, 7vw, 9rem);
    --star-fs-display-l: clamp(3.6rem, 5vw, 6rem);
    --star-fs-display-m: clamp(3rem, 3.6vw, 4.4rem);
    --star-fs-display-s: clamp(2rem, 2.2vw, 2.6rem);
    --star-fs-body-l: 1.6rem;
    --star-fs-body: 1.4rem;
    --star-fs-eyebrow: 1.15rem;
    --star-fs-micro: 1.05rem;
    --star-ls-display: -0.02em;
    --star-ls-eyebrow: 0.22em;
    --star-ls-micro: 0.16em;

    --star-gutter: clamp(2rem, 4.5vw, 6rem);
    --star-band: clamp(6.4rem, 8vw, 12rem);
    --star-grid-gap: clamp(1.2rem, 1.6vw, 2.4rem);

    --star-ease: cubic-bezier(0.22, 1, 0.36, 1);
    --star-fast: 240ms;
    --star-slow: 620ms;

    background: var(--star-cream);
    color: var(--star-black);
  }

  /* ==================================================================
   * 1. PRIMITIVAS
   * ================================================================== */
  #shopify-section-{{ section.id }} .star-home {
    font-family: var(--star-body);
    font-weight: 400; /* Inter carga sólo n4: el 300 anterior era sintético */
    color: var(--star-black);
    overflow-x: clip;
  }

  #shopify-section-{{ section.id }} .star-home :focus-visible {
    outline: 0.2rem solid var(--star-black);
    outline-offset: 0.4rem;
  }

  #shopify-section-{{ section.id }} .star-band {
    padding-block: var(--star-band);
  }

  /* Primitivas (.star-media, .star-eyebrow, .star-display, .star-prose,
   * .star-button, .star-link) viven en assets/star-moda.css. */

  /* ==================================================================
   * 3. CABECERA DE SECCIÓN — alineada a la izquierda, link a la derecha
   * ================================================================== */
  #shopify-section-{{ section.id }} .star-head {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 2.4rem;
    padding-inline: var(--star-gutter);
    padding-bottom: clamp(3.2rem, 4vw, 5.6rem);
  }

  #shopify-section-{{ section.id }} .star-head__title {
    font-size: var(--star-fs-display-m);
    margin-top: 1.6rem;
  }

  /* ==================================================================
   * 4. ANUNCIO
   * ================================================================== */
  #shopify-section-{{ section.id }} .star-announcement {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 1.6rem;
    padding: 1.3rem var(--star-gutter);
    background: var(--star-black);
    color: rgba(247, 243, 238, 0.92);
    font-size: var(--star-fs-micro);
    font-weight: 500;
    letter-spacing: var(--star-ls-micro);
    text-transform: uppercase;
    text-align: center;
  }

  #shopify-section-{{ section.id }} .star-announcement__sep {
    color: var(--star-gold);
  }

  /* ==================================================================
   * 5. HERO — split asimétrico, panel flotante que monta sobre la foto
   * ================================================================== */
  #shopify-section-{{ section.id }} .star-hero {
    display: grid;
    grid-template-columns: minmax(0, 1.08fr) minmax(0, 0.92fr);
    align-items: stretch;
  }

  #shopify-section-{{ section.id }} .star-hero__media {
    min-height: clamp(46rem, 74vh, 80rem);
  }

  /* Velo cálido en diagonal: sostiene la etiqueta y el cue sin ensuciar la foto */
  #shopify-section-{{ section.id }} .star-hero__media::after {
    content: '';
    position: absolute;
    inset: 0;
    pointer-events: none;
    background: linear-gradient(
      118deg,
      rgba(28, 27, 26, 0.34) 0%,
      rgba(28, 27, 26, 0.06) 44%,
      rgba(28, 27, 26, 0) 62%
    );
  }

  #shopify-section-{{ section.id }} .star-hero__tag {
    position: absolute;
    z-index: 1;
    top: clamp(2rem, 3vw, 4rem);
    left: clamp(2rem, 3vw, 4rem);
    padding: 0.9rem 1.6rem;
    background: rgba(247, 243, 238, 0.94);
    color: var(--star-black);
    font-size: var(--star-fs-micro);
    font-weight: 500;
    letter-spacing: var(--star-ls-micro);
    text-transform: uppercase;
  }

  /* Va sobre la foto del hero, que puede ser clara: sin la sombra el
   * texto crema desaparece contra un fondo de tono alto. */
  #shopify-section-{{ section.id }} .star-hero__cue {
    text-shadow: 0 0.1rem 0.6rem rgba(28, 27, 26, 0.55);
    position: absolute;
    z-index: 1;
    left: clamp(2rem, 3vw, 4rem);
    bottom: clamp(2rem, 3vw, 4rem);
    display: flex;
    align-items: center;
    gap: 1.2rem;
    color: var(--star-cream);
    font-size: var(--star-fs-micro);
    font-weight: 500;
    letter-spacing: var(--star-ls-micro);
    text-transform: uppercase;
  }

  #shopify-section-{{ section.id }} .star-hero__cue::after {
    content: '';
    width: 5.6rem;
    height: 0.1rem;
    background: currentColor;
    transform-origin: left center;
    animation: starCue 2.6s var(--star-ease) infinite;
  }

  @keyframes starCue {
    0%,
    100% {
      transform: scaleX(0.35);
      opacity: 0.45;
    }
    50% {
      transform: scaleX(1);
      opacity: 1;
    }
  }

  #shopify-section-{{ section.id }} .star-hero__content {
    position: relative;
    z-index: 2;
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: clamp(4.8rem, 6vw, 9rem) clamp(2.8rem, 4.5vw, 7.2rem);
    background: var(--star-white);
  }

  #shopify-section-{{ section.id }} .star-hero__title {
    font-size: var(--star-fs-display-xl);
    margin: 2.4rem 0 2.8rem;
  }

  #shopify-section-{{ section.id }} .star-hero__actions {
    display: flex;
    align-items: center;
    gap: clamp(1.6rem, 2vw, 2.8rem);
    flex-wrap: wrap;
    margin-top: clamp(3.2rem, 4vw, 4.4rem);
  }

  /* ==================================================================
   * 6. BENEFICIOS — fila de filetes, sin barra de color
   * ================================================================== */
  #shopify-section-{{ section.id }} .star-values {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    border-block: 0.1rem solid var(--star-hair);
  }

  #shopify-section-{{ section.id }} .star-values__item {
    display: flex;
    align-items: center;
    gap: 1.2rem;
    padding: clamp(2.2rem, 2.6vw, 3.2rem) clamp(1.6rem, 2.4vw, 3.2rem);
    color: var(--star-muted);
    font-size: var(--star-fs-micro);
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  #shopify-section-{{ section.id }} .star-values__item + .star-values__item {
    border-left: 0.1rem solid var(--star-hair);
  }

  /* Trazo en mocha, no en dorado: sobre crema el dorado queda en 1.7:1 */
  #shopify-section-{{ section.id }} .star-values__item svg {
    flex: none;
    width: 1.9rem;
    height: 1.9rem;
    fill: none;
    stroke: var(--star-mocha-ink);
    stroke-width: 1.25;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  /* ==================================================================
   * 7. COLECCIONES — rejilla escalonada, rótulo bajo la imagen
   * ================================================================== */
  #shopify-section-{{ section.id }} .star-collections {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: var(--star-grid-gap);
    padding-inline: var(--star-gutter);
  }

  #shopify-section-{{ section.id }} .star-collection-card {
    display: block;
    color: inherit;
    text-decoration: none;
  }

  #shopify-section-{{ section.id }} .star-collection-card .star-media {
    aspect-ratio: 4 / 5;
  }

  #shopify-section-{{ section.id }} .star-collection-card:hover .star-media > img {
    transform: scale(1.05);
  }

  #shopify-section-{{ section.id }} .star-collection-card__body {
    position: relative;
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1.6rem;
    margin-top: 1.8rem;
    padding-top: 1.8rem;
    border-top: 0.1rem solid var(--star-hair);
  }

  /* El filete se pinta en espresso de izquierda a derecha al pasar el cursor */
  #shopify-section-{{ section.id }} .star-collection-card__body::after {
    content: '';
    position: absolute;
    top: -0.1rem;
    left: 0;
    width: 0;
    height: 0.1rem;
    background: var(--star-black);
    transition: width var(--star-slow) var(--star-ease);
  }

  #shopify-section-{{ section.id }} .star-collection-card:hover .star-collection-card__body::after {
    width: 100%;
  }

  #shopify-section-{{ section.id }} .star-collection-card__title {
    font-family: var(--star-display);
    font-weight: 400;
    font-size: var(--star-fs-display-s);
    line-height: 1.1;
    letter-spacing: -0.01em;
    margin: 0;
  }

  #shopify-section-{{ section.id }} .star-collection-card__count {
    flex: none;
    color: var(--star-muted);
    font-size: var(--star-fs-micro);
    font-weight: 500;
    letter-spacing: var(--star-ls-micro);
    text-transform: uppercase;
  }

  /* ==================================================================
   * 8. MARQUEE
   * ================================================================== */
  #shopify-section-{{ section.id }} .star-marquee {
    --star-marquee-duration: 46s;
    overflow: hidden;
    padding-block: clamp(1.8rem, 2.4vw, 3rem);
    background: var(--star-beige);
    border-block: 0.1rem solid rgba(28, 27, 26, 0.1);
  }

  #shopify-section-{{ section.id }} .star-marquee__track {
    display: flex;
    width: max-content;
    animation: starMarquee var(--star-marquee-duration) linear infinite;
  }

  #shopify-section-{{ section.id }} .star-marquee:hover .star-marquee__track {
    animation-play-state: paused;
  }

  #shopify-section-{{ section.id }} .star-marquee__item {
    display: flex;
    align-items: center;
    gap: 3.2rem;
    padding-inline: 2.4rem;
    font-family: var(--star-display);
    font-size: clamp(2rem, 2.6vw, 3.2rem);
    line-height: 1.2;
    /* Al 0.5 daba 3.66:1 sobre el beige. A 32px eso pasa como texto
     * grande, pero en móvil la tipografía baja a 20px y ya no cumple.
     * Al 0.72 da 6.1:1 y sirve en los dos tamaños. */
    color: rgba(28, 27, 26, 0.72);
    white-space: nowrap;
  }

  /* Alterna romana e itálica: le da cadencia al listado.
   * La cadencia la marca la itálica, no el color: el mocha-ink está
   * calibrado a 5.2:1 sobre CREMA, pero esta banda es beige (más
   * oscuro) y ahí se queda en 3.66:1 — insuficiente para los 20px que
   * mide la tipografía en móvil. */
  #shopify-section-{{ section.id }} .star-marquee__item:nth-child(even) {
    font-style: italic;
  }

  #shopify-section-{{ section.id }} .star-marquee__item::after {
    content: '✦';
    font-family: var(--star-body);
    font-size: 1.1rem;
    color: var(--star-mocha);
  }

  @keyframes starMarquee {
    to {
      transform: translateX(-50%);
    }
  }

  /* ==================================================================
   * 9. REJILLA DE PRODUCTO
   * ================================================================== */
  #shopify-section-{{ section.id }} .star-products {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: clamp(3.2rem, 4vw, 5.6rem) var(--star-grid-gap);
    padding-inline: var(--star-gutter);
  }

  #shopify-section-{{ section.id }} .star-cta {
    display: flex;
    justify-content: center;
    padding-top: clamp(4rem, 5vw, 6.4rem);
  }

  /* ==================================================================
   * 10. BANNER EDITORIAL
   * ================================================================== */
  #shopify-section-{{ section.id }} .star-banner {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    background: var(--star-black);
    color: var(--star-cream);
  }

  #shopify-section-{{ section.id }} .star-banner__content {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    justify-content: center;
    padding: clamp(5.6rem, 7vw, 10rem) clamp(2.8rem, 4.5vw, 7.2rem);
  }

  #shopify-section-{{ section.id }} .star-banner__eyebrow {
    color: var(--star-gold);
  }

  #shopify-section-{{ section.id }} .star-banner__eyebrow::before {
    background: currentColor;
    opacity: 0.5;
  }

  #shopify-section-{{ section.id }} .star-banner__title {
    font-size: var(--star-fs-display-l);
    margin: 2.4rem 0 2.8rem;
  }

  #shopify-section-{{ section.id }} .star-banner__title em {
    color: var(--star-gold);
  }

  #shopify-section-{{ section.id }} .star-banner .star-prose {
    color: rgba(247, 243, 238, 0.72);
  }

  #shopify-section-{{ section.id }} .star-banner__actions {
    margin-top: clamp(3.2rem, 4vw, 4.4rem);
  }

  /* Cifras: lockup discreto bajo un filete dorado, no un número de 80px */
  #shopify-section-{{ section.id }} .star-banner__stats {
    display: flex;
    gap: clamp(2.8rem, 4vw, 5.6rem);
    width: 100%;
    max-width: 46rem;
    margin-top: clamp(3.6rem, 4.5vw, 5.6rem);
    padding-top: 2.8rem;
    border-top: 0.1rem solid rgba(216, 177, 106, 0.32);
  }

  #shopify-section-{{ section.id }} .star-banner__number {
    display: block;
    font-family: var(--star-display);
    font-size: clamp(3.2rem, 3.6vw, 4.4rem);
    line-height: 1;
    letter-spacing: -0.01em;
    color: var(--star-gold);
  }

  #shopify-section-{{ section.id }} .star-banner__label {
    display: block;
    margin-top: 0.9rem;
    color: rgba(247, 243, 238, 0.6);
    font-size: var(--star-fs-micro);
    font-weight: 500;
    letter-spacing: var(--star-ls-micro);
    text-transform: uppercase;
  }

  #shopify-section-{{ section.id }} .star-banner__media {
    min-height: clamp(38rem, 44vw, 62rem);
    background: linear-gradient(150deg, #2b2724 0%, #1c1b1a 100%);
  }

  /* Marco dorado interior — el detalle que lo vuelve editorial */
  #shopify-section-{{ section.id }} .star-banner__media::after {
    content: '';
    position: absolute;
    inset: clamp(1.6rem, 2vw, 3.2rem);
    border: 0.1rem solid rgba(216, 177, 106, 0.38);
    pointer-events: none;
  }

  /* ==================================================================
   * 11. BESTSELLERS — banda en crema alta para separar del banner
   * ================================================================== */
  #shopify-section-{{ section.id }} .star-bestsellers {
    background: var(--star-white);
  }

  /* ==================================================================
   * 12. NEWSLETTER — banda en beige arena
   *
   * Antes iba en rosa nude. El rosa es el tono más saturado de la paleta
   * y en una banda entera pesaba demasiado; sigue vivo donde aporta
   * información, que es el badge de rebaja de la tarjeta y de la ficha.
   * ================================================================== */
  #shopify-section-{{ section.id }} .star-newsletter {
    background: var(--star-beige);
    text-align: center;
  }

  #shopify-section-{{ section.id }} .star-newsletter__inner {
    max-width: 62rem;
    margin-inline: auto;
    padding-inline: var(--star-gutter);
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  #shopify-section-{{ section.id }} .star-newsletter__title {
    font-size: var(--star-fs-display-m);
    margin: 2rem 0 1.6rem;
  }

  /* Sobre el beige, el mocha decorativo no llega; el mocha-ink da 3.5:1
   * y el titular mide 30-44px, así que cumple como texto grande. */
  #shopify-section-{{ section.id }} .star-newsletter__title em {
    color: var(--star-mocha-ink);
  }

  /* El eyebrow es de 11.5px: necesita 4.5:1 y el mocha-ink se queda en
   * 3.5:1 sobre el beige. En espresso da 10.5:1. */
  #shopify-section-{{ section.id }} .star-newsletter .star-eyebrow {
    color: var(--star-black);
  }

  #shopify-section-{{ section.id }} .star-newsletter .star-prose {
    color: rgba(28, 27, 26, 0.72);
    max-width: 46ch;
  }

  #shopify-section-{{ section.id }} .star-newsletter__form {
    display: flex;
    align-items: flex-end;
    gap: 1.6rem;
    width: 100%;
    max-width: 48rem;
    margin-top: clamp(3.2rem, 4vw, 4.4rem);
    flex-wrap: wrap;
  }

  #shopify-section-{{ section.id }} .star-newsletter__field {
    flex: 1 1 auto;
    min-width: 0;
    padding: 1.4rem 0;
    border: 0;
    border-bottom: 0.1rem solid rgba(28, 27, 26, 0.42);
    border-radius: 0;
    background: transparent;
    color: var(--star-black);
    font-family: var(--star-body);
    font-size: var(--star-fs-body);
    transition: border-color var(--star-fast) var(--star-ease);
  }

  #shopify-section-{{ section.id }} .star-newsletter__field::placeholder {
    color: rgba(28, 27, 26, 0.7);
  }

  #shopify-section-{{ section.id }} .star-newsletter__field:focus {
    outline: 0;
    border-bottom-color: var(--star-black);
    border-bottom-width: 0.2rem;
  }

  #shopify-section-{{ section.id }} .star-newsletter__submit {
    flex: none;
    cursor: pointer;
    --btn-hover-bg: var(--star-white);
    --btn-hover-fg: var(--star-black);
  }

  #shopify-section-{{ section.id }} .star-newsletter__note {
    margin-top: 1.6rem;
    font-size: var(--star-fs-micro);
    letter-spacing: 0.08em;
    /* al 0.66 sobre el beige daba 4.08:1 y la nota mide 10.5px */
    color: rgba(28, 27, 26, 0.72);
  }

  #shopify-section-{{ section.id }} .star-newsletter__feedback {
    flex: 1 0 100%; /* el form es flex-row: fuerza salto de línea */
    margin: 0.4rem 0 0;
    font-size: var(--star-fs-body);
    text-align: left;
    color: var(--star-black);
  }

  /* ==================================================================
   * 13. INSTAGRAM
   * ================================================================== */
  #shopify-section-{{ section.id }} .star-instagram__handle {
    display: inline-flex;
    align-items: center;
    gap: 0.9rem;
    color: var(--star-mocha-ink);
    font-size: var(--star-fs-eyebrow);
    font-weight: 500;
    letter-spacing: var(--star-ls-micro);
    text-transform: uppercase;
    text-decoration: none;
    white-space: nowrap;
  }

  #shopify-section-{{ section.id }} .star-instagram__handle:hover {
    color: var(--star-black);
  }

  #shopify-section-{{ section.id }} .star-instagram__handle svg {
    width: 1.6rem;
    height: 1.6rem;
  }

  #shopify-section-{{ section.id }} .star-instagram__grid {
    display: grid;
    grid-template-columns: repeat(6, minmax(0, 1fr));
    gap: var(--star-grid-gap);
    padding-inline: var(--star-gutter);
  }

  #shopify-section-{{ section.id }} .star-ig-card {
    display: block;
    aspect-ratio: 1;
  }

  #shopify-section-{{ section.id }} .star-ig-card::after {
    content: '';
    position: absolute;
    inset: 0;
    background: rgba(28, 27, 26, 0);
    transition: background var(--star-fast) var(--star-ease);
  }

  #shopify-section-{{ section.id }} .star-ig-card:hover::after {
    background: rgba(28, 27, 26, 0.38);
  }

  #shopify-section-{{ section.id }} .star-ig-card__glyph {
    position: absolute;
    inset: 0;
    z-index: 1;
    display: grid;
    place-items: center;
    color: var(--star-cream);
    opacity: 0;
    transform: scale(0.88);
    transition: opacity var(--star-fast) var(--star-ease),
      transform var(--star-fast) var(--star-ease);
  }

  #shopify-section-{{ section.id }} .star-ig-card__glyph svg {
    width: 2.2rem;
    height: 2.2rem;
  }

  #shopify-section-{{ section.id }} .star-ig-card:hover .star-ig-card__glyph {
    opacity: 1;
    transform: scale(1);
  }

  #shopify-section-{{ section.id }} .star-ig-card:hover .star-media > img {
    transform: scale(1.05);
  }

  /* ==================================================================
   * 14. RESPONSIVE
   * ================================================================== */
  @media screen and (min-width: 990px) {
    /* El panel monta sobre la foto y flota: la firma editorial del hero */
    #shopify-section-{{ section.id }} .star-hero__content {
      align-self: center;
      margin: clamp(3.2rem, 5vw, 7rem) clamp(2rem, 4vw, 6rem) clamp(3.2rem, 5vw, 7rem)
        clamp(-8rem, -6vw, -3.2rem);
    }

    /* Escalonado par/impar — rompe la cuadrícula sin romper la rejilla */
    #shopify-section-{{ section.id }} .star-collections {
      padding-bottom: 5.6rem;
    }

    #shopify-section-{{ section.id }} .star-collections > :nth-child(even) {
      transform: translateY(5.6rem);
    }
  }

  @media screen and (max-width: 989px) {
    #shopify-section-{{ section.id }} .star-hero,
    #shopify-section-{{ section.id }} .star-banner {
      grid-template-columns: minmax(0, 1fr);
    }

    #shopify-section-{{ section.id }} .star-hero__media {
      min-height: clamp(38rem, 54vh, 52rem);
    }

    #shopify-section-{{ section.id }} .star-banner__media {
      min-height: 36rem;
      order: -1;
    }

    #shopify-section-{{ section.id }} .star-values {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    #shopify-section-{{ section.id }} .star-values__item:nth-child(odd) {
      border-left: 0;
    }

    #shopify-section-{{ section.id }} .star-values__item:nth-child(n + 3) {
      border-top: 0.1rem solid var(--star-hair);
    }

    #shopify-section-{{ section.id }} .star-collections,
    #shopify-section-{{ section.id }} .star-products {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    #shopify-section-{{ section.id }} .star-instagram__grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  @media screen and (max-width: 749px) {
    /* En móvil una sola promesa: tres líneas de versalitas de 10px no se leen */
    #shopify-section-{{ section.id }} .star-announcement__extra {
      display: none;
    }

    #shopify-section-{{ section.id }} .star-head {
      flex-direction: column;
      align-items: flex-start;
      gap: 1.6rem;
    }

    #shopify-section-{{ section.id }} .star-hero__actions {
      gap: 1.6rem;
    }

    #shopify-section-{{ section.id }} .star-hero__actions .star-button {
      flex: 1 1 auto;
    }

    #shopify-section-{{ section.id }} .star-newsletter__form {
      flex-direction: column;
      align-items: stretch;
    }

    #shopify-section-{{ section.id }} .star-instagram__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  /* ==================================================================
   * 15. MOVIMIENTO REDUCIDO
   * ================================================================== */
  @media (prefers-reduced-motion: reduce) {
    #shopify-section-{{ section.id }} .star-marquee__track,
    #shopify-section-{{ section.id }} .star-hero__cue::after {
      animation: none;
    }

    #shopify-section-{{ section.id }} .star-hero__cue::after {
      transform: scaleX(1);
      opacity: 0.6;
    }

    #shopify-section-{{ section.id }} .star-collection-card__body::after {
      transition-duration: 1ms;
    }
  }
</style>

{%- liquid
  assign reveal = ''
  if settings.animations_reveal_on_scroll
    assign reveal = 'scroll-trigger animate--slide-in'
  endif
-%}

{%- capture arrow_icon -%}
  <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M4 12h15m-6-7 7 7-7 7"/></svg>
{%- endcapture -%}

<div class="star-home">
  {%- if section.settings.show_announcement -%}
    <div class="star-announcement">
      <span>{{ section.settings.announcement_text_1 }}</span>
      {%- if section.settings.announcement_text_2 != blank -%}
        <span class="star-announcement__sep star-announcement__extra" aria-hidden="true">✦</span>
        <span class="star-announcement__extra">{{ section.settings.announcement_text_2 }}</span>
      {%- endif -%}
      {%- if section.settings.announcement_text_3 != blank -%}
        <span class="star-announcement__sep star-announcement__extra" aria-hidden="true">✦</span>
        <span class="star-announcement__extra">{{ section.settings.announcement_text_3 }}</span>
      {%- endif -%}
    </div>
  {%- endif -%}

  {%- comment -%} ---------- HERO ---------- {%- endcomment -%}
  <section class="star-hero">
    <div class="star-media star-hero__media">
      {%- if section.settings.hero_image != blank -%}
        {{
          section.settings.hero_image
          | image_url: width: 1800
          | image_tag:
            widths: '600, 800, 1000, 1200, 1500, 1800',
            sizes: '(min-width: 990px) 55vw, 100vw',
            loading: 'eager',
            fetchpriority: 'high',
            alt: section.settings.hero_image.alt
        }}
      {%- else -%}
        <div class="star-placeholder">Foto editorial</div>
      {%- endif -%}

      {%- if section.settings.hero_tag != blank -%}
        <div class="star-hero__tag">{{ section.settings.hero_tag }}</div>
      {%- endif -%}

      {%- if section.settings.hero_cue != blank -%}
        <div class="star-hero__cue" aria-hidden="true">{{ section.settings.hero_cue }}</div>
      {%- endif -%}
    </div>

    <div class="star-hero__content">
      {%- if section.settings.hero_eyebrow != blank -%}
        <span class="star-eyebrow">{{ section.settings.hero_eyebrow }}</span>
      {%- endif -%}

      <h1 class="star-display star-hero__title">{{ section.settings.hero_title }}</h1>

      {%- if section.settings.hero_text != blank -%}
        <div class="star-prose">{{ section.settings.hero_text }}</div>
      {%- endif -%}

      <div class="star-hero__actions">
        {%- if section.settings.hero_button_label != blank -%}
          <a
            class="star-button"
            href="{{ section.settings.hero_button_link | default: routes.all_products_collection_url }}"
          >
            {{ section.settings.hero_button_label }}
          </a>
        {%- endif -%}
        {%- if section.settings.hero_secondary_label != blank -%}
          <a
            class="star-link"
            href="{{ section.settings.hero_secondary_link | default: routes.all_products_collection_url }}"
          >
            {{ section.settings.hero_secondary_label }}
            {{ arrow_icon }}
          </a>
        {%- endif -%}
      </div>
    </div>
  </section>

  {%- comment -%} ---------- BENEFICIOS ---------- {%- endcomment -%}
  <div class="star-values">
    <div class="star-values__item">
      <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M1 3h13v13H1zM14 8h4l3 3v5h-7z"/><circle cx="5.5" cy="18.5" r="2"/><circle cx="17.5" cy="18.5" r="2"/></svg>
      <span>{{ section.settings.strip_1 }}</span>
    </div>
    <div class="star-values__item">
      <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
      <span>{{ section.settings.strip_2 }}</span>
    </div>
    <div class="star-values__item">
      <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="m12 2 2.9 6.2 6.6.9-4.8 4.7 1.2 6.7L12 17.4 6.1 20.5l1.2-6.7L2.5 9.1l6.6-.9z"/></svg>
      <span>{{ section.settings.strip_3 }}</span>
    </div>
    <div class="star-values__item">
      <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M21 11.5a8.4 8.4 0 0 1-9 8.4 8.9 8.9 0 0 1-4-.9L3 20.5l1.5-4.6A8.4 8.4 0 0 1 12 3.1a8.4 8.4 0 0 1 9 8.4z"/></svg>
      <span>{{ section.settings.strip_4 }}</span>
    </div>
  </div>

  {%- comment -%} ---------- COLECCIONES ---------- {%- endcomment -%}
  <section class="star-band {{ reveal }}">
    <div class="star-head">
      <div>
        {%- if section.settings.collections_eyebrow != blank -%}
          <span class="star-eyebrow">{{ section.settings.collections_eyebrow }}</span>
        {%- endif -%}
        <h2 class="star-display star-head__title">{{ section.settings.collections_title }}</h2>
      </div>
      {%- if section.settings.collections_link_label != blank -%}
        <a
          class="star-link"
          href="{{ section.settings.collections_link | default: routes.collections_url }}"
        >
          {{ section.settings.collections_link_label }}
          {{ arrow_icon }}
        </a>
      {%- endif -%}
    </div>

    <div class="star-collections">
      {%- for block in section.blocks -%}
        {%- if block.type == 'collection_card' -%}
          {%- liquid
            assign card_collection = block.settings.collection
            assign card_image = block.settings.image
            if card_image == blank and card_collection.featured_image != blank
              assign card_image = card_collection.featured_image
            endif
            assign card_title = block.settings.title
            if card_title == blank and card_collection != blank
              assign card_title = card_collection.title
            endif
            assign card_url = block.settings.link
            if card_url == blank and card_collection != blank
              assign card_url = card_collection.url
            endif
          -%}
          <a
            class="star-collection-card"
            href="{{ card_url | default: routes.all_products_collection_url }}"
            {{ block.shopify_attributes }}
          >
            <div class="star-media">
              {%- if card_image != blank -%}
                {{
                  card_image
                  | image_url: width: 1000
                  | image_tag:
                    widths: '360, 540, 720, 1000',
                    sizes: '(min-width: 990px) 24vw, (min-width: 750px) 46vw, 46vw',
                    loading: 'lazy',
                    alt: card_image.alt
                }}
              {%- else -%}
                <div class="star-placeholder">Colección</div>
              {%- endif -%}
            </div>

            <div class="star-collection-card__body">
              <h3 class="star-collection-card__title">{{ card_title | default: 'Colección' }}</h3>
              <span class="star-collection-card__count">
                {%- if block.settings.caption != blank -%}
                  {{ block.settings.caption }}
                {%- elsif card_collection != blank -%}
                  {{ card_collection.products_count }}
                  {%- if card_collection.products_count == 1 %} pieza{% else %} piezas{% endif -%}
                {%- endif -%}
              </span>
            </div>
          </a>
        {%- endif -%}
      {%- endfor -%}
    </div>
  </section>

  {%- comment -%} ---------- MARQUEE ---------- {%- endcomment -%}
  {%- if marquee_words.size > 0 -%}
    <div class="star-marquee" aria-hidden="true">
      <div class="star-marquee__track">
        {%- for pass in (1..2) -%}
          {%- for word in marquee_words -%}
            <span class="star-marquee__item">{{ word | strip }}</span>
          {%- endfor -%}
        {%- endfor -%}
      </div>
    </div>
  {%- endif -%}

  {%- comment -%} ---------- NUEVOS INGRESOS ---------- {%- endcomment -%}
  <section class="star-band {{ reveal }}">
    <div class="star-head">
      <div>
        {%- if section.settings.new_arrivals_eyebrow != blank -%}
          <span class="star-eyebrow">{{ section.settings.new_arrivals_eyebrow }}</span>
        {%- endif -%}
        <h2 class="star-display star-head__title">{{ section.settings.new_arrivals_title }}</h2>
      </div>
      <a
        class="star-link"
        href="{{ new_arrivals.url | default: routes.all_products_collection_url }}"
      >
        Ver todo
        {{ arrow_icon }}
      </a>
    </div>

    <div class="star-products">
      {%- if new_arrivals != blank and new_arrivals.products_count > 0 -%}
        {%- for product in new_arrivals.products limit: section.settings.products_to_show -%}
          {% render 'star-product-card', product: product, section_id: section.id, badge_mode: 'new' %}
        {%- endfor -%}
      {%- else -%}
        {%- for i in (1..4) -%}
          {% render 'star-product-card', section_id: section.id %}
        {%- endfor -%}
      {%- endif -%}
    </div>

    {%- if section.settings.new_arrivals_button_label != blank -%}
      <div class="star-cta">
        <a
          class="star-button star-button--outline"
          href="{{ new_arrivals.url | default: routes.all_products_collection_url }}"
        >
          {{ section.settings.new_arrivals_button_label }}
        </a>
      </div>
    {%- endif -%}
  </section>

  {%- comment -%} ---------- BANNER EDITORIAL ---------- {%- endcomment -%}
  <section class="star-banner">
    <div class="star-banner__content">
      {%- if section.settings.banner_eyebrow != blank -%}
        <span class="star-eyebrow star-banner__eyebrow">{{ section.settings.banner_eyebrow }}</span>
      {%- endif -%}

      <h2 class="star-display star-banner__title">{{ section.settings.banner_title }}</h2>

      {%- if section.settings.banner_text != blank -%}
        <div class="star-prose">{{ section.settings.banner_text }}</div>
      {%- endif -%}

      {%- if section.settings.banner_button_label != blank -%}
        <div class="star-banner__actions">
          <a
            class="star-button star-button--gold"
            href="{{ section.settings.banner_button_link | default: routes.all_products_collection_url }}"
          >
            {{ section.settings.banner_button_label }}
          </a>
        </div>
      {%- endif -%}

      {%- if section.settings.banner_number != blank or section.settings.banner_number_2 != blank -%}
        <dl class="star-banner__stats">
          {%- if section.settings.banner_number != blank -%}
            <div>
              <dt class="star-banner__number">{{ section.settings.banner_number }}</dt>
              <dd class="star-banner__label">{{ section.settings.banner_label }}</dd>
            </div>
          {%- endif -%}
          {%- if section.settings.banner_number_2 != blank -%}
            <div>
              <dt class="star-banner__number">{{ section.settings.banner_number_2 }}</dt>
              <dd class="star-banner__label">{{ section.settings.banner_label_2 }}</dd>
            </div>
          {%- endif -%}
        </dl>
      {%- endif -%}
    </div>

    <div class="star-media star-banner__media">
      {%- if section.settings.banner_image != blank -%}
        {{
          section.settings.banner_image
          | image_url: width: 1400
          | image_tag:
            widths: '600, 800, 1000, 1400',
            sizes: '(min-width: 990px) 50vw, 100vw',
            loading: 'lazy',
            alt: section.settings.banner_image.alt
        }}
      {%- endif -%}
    </div>
  </section>

  {%- comment -%} ---------- MÁS VENDIDOS ---------- {%- endcomment -%}
  <section class="star-band star-bestsellers {{ reveal }}">
    <div class="star-head">
      <div>
        {%- if section.settings.bestsellers_eyebrow != blank -%}
          <span class="star-eyebrow">{{ section.settings.bestsellers_eyebrow }}</span>
        {%- endif -%}
        <h2 class="star-display star-head__title">{{ section.settings.bestsellers_title }}</h2>
      </div>
      <a
        class="star-link"
        href="{{ bestsellers.url | default: routes.all_products_collection_url }}"
      >
        Ver todo
        {{ arrow_icon }}
      </a>
    </div>

    <div class="star-products">
      {%- if bestsellers != blank and bestsellers.products_count > 0 -%}
        {%- for product in bestsellers.products limit: section.settings.products_to_show -%}
          {% render 'star-product-card', product: product, section_id: section.id, badge_mode: 'sale' %}
        {%- endfor -%}
      {%- else -%}
        {%- for i in (1..4) -%}
          {% render 'star-product-card', section_id: section.id %}
        {%- endfor -%}
      {%- endif -%}
    </div>
  </section>

  {%- comment -%} ---------- NEWSLETTER ---------- {%- endcomment -%}
  {%- if section.settings.show_newsletter -%}
    <section class="star-band star-newsletter">
      <div class="star-newsletter__inner">
        {%- if section.settings.newsletter_eyebrow != blank -%}
          <span class="star-eyebrow">{{ section.settings.newsletter_eyebrow }}</span>
        {%- endif -%}

        <h2 class="star-display star-newsletter__title">{{ section.settings.newsletter_title }}</h2>

        {%- if section.settings.newsletter_text != blank -%}
          <div class="star-prose">{{ section.settings.newsletter_text }}</div>
        {%- endif -%}

        {%- form 'customer', id: 'StarNewsletter', class: 'star-newsletter__form' -%}
          <input type="hidden" name="contact[tags]" value="newsletter">
          <label class="visually-hidden" for="StarNewsletterEmail">
            {{ 'newsletter.label' | t }}
          </label>
          <input
            id="StarNewsletterEmail"
            class="star-newsletter__field"
            type="email"
            name="contact[email]"
            value="{{ form.email }}"
            autocomplete="email"
            placeholder="{{ section.settings.newsletter_placeholder }}"
            required
            {% if form.errors %}
              aria-invalid="true"
              aria-describedby="StarNewsletterError"
            {% endif %}
          >
          <button
            class="star-button star-newsletter__submit"
            type="submit"
            name="commit"
          >
            {{ section.settings.newsletter_button_label }}
          </button>

          {%- if form.errors -%}
            <p class="star-newsletter__feedback" id="StarNewsletterError" role="alert">
              {{ form.errors.translated_fields.email | capitalize }} {{ form.errors.messages.email }}
            </p>
          {%- endif -%}

          {%- if form.posted_successfully? -%}
            <p class="star-newsletter__feedback" tabindex="-1" autofocus>
              {{ 'newsletter.success' | t }}
            </p>
          {%- endif -%}
        {%- endform -%}

        {%- if section.settings.newsletter_note != blank -%}
          <p class="star-newsletter__note">{{ section.settings.newsletter_note }}</p>
        {%- endif -%}
      </div>
    </section>
  {%- endif -%}

  {%- comment -%} ---------- INSTAGRAM ---------- {%- endcomment -%}
  <section class="star-band {{ reveal }}">
    <div class="star-head">
      <div>
        {%- if section.settings.instagram_eyebrow != blank -%}
          <span class="star-eyebrow">{{ section.settings.instagram_eyebrow }}</span>
        {%- endif -%}
        <h2 class="star-display star-head__title">{{ section.settings.instagram_title }}</h2>
      </div>
      {%- if section.settings.instagram_handle != blank -%}
        <a
          class="star-instagram__handle"
          href="{{ section.settings.instagram_link }}"
          target="_blank"
          rel="noopener"
        >
          {{ 'icon-instagram.svg' | inline_asset_content }}
          {{ section.settings.instagram_handle }}
        </a>
      {%- endif -%}
    </div>

    <div class="star-instagram__grid">
      {%- for block in section.blocks -%}
        {%- if block.type == 'instagram_tile' -%}
          <a
            class="star-media star-ig-card"
            href="{{ block.settings.link | default: section.settings.instagram_link }}"
            target="_blank"
            rel="noopener"
            {{ block.shopify_attributes }}
          >
            {%- if block.settings.image != blank -%}
              {{
                block.settings.image
                | image_url: width: 700
                | image_tag:
                  widths: '240, 360, 480, 700',
                  sizes: '(min-width: 990px) 16vw, (min-width: 750px) 32vw, 48vw',
                  loading: 'lazy',
                  alt: block.settings.image.alt
              }}
            {%- else -%}
              <div class="star-placeholder">Instagram</div>
            {%- endif -%}
            <span class="star-ig-card__glyph" aria-hidden="true">
              {{ 'icon-instagram.svg' | inline_asset_content }}
            </span>
          </a>
        {%- endif -%}
      {%- endfor -%}
    </div>
  </section>
</div>

{% schema %}
{
  "name": "Star Moda homepage",
  "settings": [
    {
      "type": "header",
      "content": "Barra de anuncio"
    },
    {
      "type": "checkbox",
      "id": "show_announcement",
      "label": "Mostrar barra de anuncio",
      "default": true
    },
    {
      "type": "text",
      "id": "announcement_text_1",
      "label": "Anuncio 1",
      "info": "El único que se ve en móvil. Pon aquí la promesa más fuerte.",
      "default": "Envío gratis en compras mayores a $999"
    },
    {
      "type": "text",
      "id": "announcement_text_2",
      "label": "Anuncio 2",
      "default": "Recogida en tienda disponible"
    },
    {
      "type": "text",
      "id": "announcement_text_3",
      "label": "Anuncio 3",
      "default": "Nuevos ingresos cada semana"
    },
    {
      "type": "header",
      "content": "Hero"
    },
    {
      "type": "image_picker",
      "id": "hero_image",
      "label": "Imagen hero",
      "info": "Vertical u horizontal amplia. El panel de texto monta sobre el borde derecho, deja aire ahí."
    },
    {
      "type": "text",
      "id": "hero_tag",
      "label": "Etiqueta sobre la foto",
      "default": "Nueva Colección"
    },
    {
      "type": "text",
      "id": "hero_eyebrow",
      "label": "Eyebrow",
      "default": "Western & Clean Girl"
    },
    {
      "type": "inline_richtext",
      "id": "hero_title",
      "label": "Título",
      "info": "Usa cursiva para la palabra clave: se pinta en mocha.",
      "default": "Estilo que <em>te define.</em>"
    },
    {
      "type": "richtext",
      "id": "hero_text",
      "label": "Texto",
      "default": "<p>Moda femenina con carácter. Piezas que combinan la esencia western con el minimalismo contemporáneo.</p>"
    },
    {
      "type": "text",
      "id": "hero_button_label",
      "label": "Botón principal",
      "default": "Ver colección"
    },
    {
      "type": "url",
      "id": "hero_button_link",
      "label": "Link botón principal"
    },
    {
      "type": "text",
      "id": "hero_secondary_label",
      "label": "Link secundario",
      "default": "Nuevos ingresos"
    },
    {
      "type": "url",
      "id": "hero_secondary_link",
      "label": "Link secundario — destino"
    },
    {
      "type": "text",
      "id": "hero_cue",
      "label": "Indicador de scroll",
      "info": "Texto corto abajo de la foto. Déjalo vacío para ocultarlo.",
      "default": "Desliza"
    },
    {
      "type": "header",
      "content": "Beneficios"
    },
    {
      "type": "text",
      "id": "strip_1",
      "label": "Beneficio 1",
      "default": "Envío a todo México"
    },
    {
      "type": "text",
      "id": "strip_2",
      "label": "Beneficio 2",
      "default": "Recogida en tienda"
    },
    {
      "type": "text",
      "id": "strip_3",
      "label": "Beneficio 3",
      "default": "Nuevos ingresos semanales"
    },
    {
      "type": "text",
      "id": "strip_4",
      "label": "Beneficio 4",
      "default": "Atención por WhatsApp"
    },
    {
      "type": "header",
      "content": "Colecciones"
    },
    {
